# Token du bot (Discord Developer Portal > Applications > ton app > Bot > Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Nom exact du rôle à ping (doit exister sur le serveur, sans le @)
FLEX_ROLE_NAME=FLEX

# Nombre de joueurs max dans une session de flex
FLEX_MAX_PLAYERS=5

# Durée par défaut (en heures) avant qu'un appel au flex expire automatiquement
FLEX_TTL_HOURS=6

# Optionnel : liste d'IDs de serveurs autorisés séparés par des virgules.
# Laisse vide pour autoriser tous les serveurs où le bot est invité.
ALLOWED_GUILD_IDS=

# Optionnel : chemin du fichier de sauvegarde des sessions actives
FLEX_DATA_FILE=data/flex_sessions.json
